# ===========================================================
# RJChronosConnect — Variáveis de Ambiente
# Copie este arquivo para .env e configure os valores
# ===========================================================

# --- Ambiente ---
ENVIRONMENT=development
# ENVIRONMENT=production

# --- Domínio (Produção) ---
DOMAIN=chronos.rjsolucoes.com
# Usado pelo Nginx e CORS. Ajuste para seu domínio real.

# --- PostgreSQL ---
POSTGRES_USER=rjchronos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=rjchronos

# --- GenieACS ---
UI_JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_KEY_64CHARS
GENIEACS_NBI_URL=http://genieacs:7557

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ ---
RABBITMQ_USER=rjchronos
RABBITMQ_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- JWT Backend ---
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_KEY_64CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Separar por vírgula. Em dev: http://localhost:5173,http://localhost:3000
# Em prod: https://chronos.rjsolucoes.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rjchronos.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gunicorn (Produção) ---
# Regra: 2 * CPU_CORES + 1
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# --- Grafana ---
GRAFANA_PASSWORD=CHANGE_ME_IN_PRODUCTION

# --- Log Level ---
# debug, info, warning, error
LOG_LEVEL=info